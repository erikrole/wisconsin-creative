# ============================================================
# Wisconsin Creative — Environment Variables
# ============================================================
# Copy to .env.local and fill in values for local development.
# `npm run dev` creates a gitignored .env.development.local override when the
# local session secret is missing or too short; build and production paths still
# require an explicitly configured SESSION_SECRET.

# ── Required ──────────────────────────────────────────────

# Pooled PostgreSQL connection string for the application runtime (Neon pooler)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct PostgreSQL connection string for Prisma CLI migrations and introspection.
# Repository scripts also accept DATABASE_URL_UNPOOLED, the equivalent name
# provided by the Neon Vercel integration. Never point either key at a -pooler host.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Session security
SESSION_SECRET="generate-a-random-64-char-string"
SESSION_COOKIE_NAME="gear-tracker-session"

# Shared software vault. Required when the Software tab is used; generate once
# with `openssl rand -base64 32` and keep the same value across deployments.
SOFTWARE_VAULT_KEY="base64-encoded-32-byte-key"

# ── Optional (Production Features) ────────────────────────

# Vercel Cron — secures /api/cron/* endpoints
# CRON_SECRET=""

# Public production URL used for generated links, email actions, and app handoffs
# APP_URL="https://wisconsincreative.com"

# Browser Push — generate once with `npx web-push generate-vapid-keys` and keep
# the same keys across deployments. The public key is returned to authenticated
# browsers; the private key must remain server-only. Subject must be an HTTPS
# URL or a mailto address.
# WEB_PUSH_VAPID_PUBLIC_KEY=""
# WEB_PUSH_VAPID_PRIVATE_KEY=""
# WEB_PUSH_SUBJECT="mailto:notifications@wisconsincreative.com"

# WebAuthn passkey configuration. Set the RP ID and exact origin explicitly in
# production. The RP ID must match the host users use for passkey sign-in.
# PASSKEY_RP_NAME="Wisconsin Creative"
# PASSKEY_RP_ID="wisconsincreative.com"
# PASSKEY_ORIGINS="https://wisconsincreative.com"

# Optional comma-separated override for CSRF origin checks. When unset, runtime
# trusts APP_URL plus the Wisconsin Creative canonical and rollout legacy hosts.
# TRUSTED_ORIGINS="https://wisconsincreative.com"

# Resend — enables email delivery (falls back to console.log)
# RESEND_API_KEY=""
# EMAIL_FROM="Wisconsin Creative <noreply@wisconsincreative.com>"

# Sentry — error tracking (app works fine without)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Vercel Blob — enables image uploads on asset pages
# BLOB_READ_WRITE_TOKEN=""

# Brand assets — must point to a separate private Vercel Blob store. Do not
# reuse BLOB_READ_WRITE_TOKEN or SIGNATURE_BLOB_READ_WRITE_TOKEN.
# RESOURCE_ASSET_BLOB_READ_WRITE_TOKEN=""

# Signature Capture — must point to a separate private Blob store. Do not
# reuse BLOB_READ_WRITE_TOKEN, which is reserved for public media uploads.
# SIGNATURE_BLOB_READ_WRITE_TOKEN=""
# For Vercel OIDC deployments, set the private store ID and keep
# VERCEL_OIDC_TOKEN available in the runtime instead of using a static token.
# SIGNATURE_BLOB_STORE_ID=""

# Product Image Search. Optional. Brave is the default provider.
# BRAVE_SEARCH_API_KEY=""

# Upstash Redis — durable, cross-instance API rate limiting (provision via
# Vercel Marketplace). When unset, rate limiting falls back to per-instance
# in-memory counters. KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Student badge achievements — default off until rollout verification passes
# BADGES_ENABLED="false"

# Internal maintenance operators who may opt into hidden smoke/test identities
# in production tools. Comma-separated email addresses.
# INTERNAL_OPERATOR_EMAILS="owner@example.com"
# Private usage report access. ADMIN role does not grant access.
# USAGE_ANALYTICS_OWNER_EMAILS="owner@example.com"
# Optional separate HMAC secret; SESSION_SECRET is used when omitted.
# USAGE_ANALYTICS_HASH_SECRET="generate-a-random-64-char-string"
# Optional current iOS release target used to label installed clients Latest/Stale.
# Leave unset to show Compare unavailable rather than infer a release.
# IOS_LATEST_APP_VERSION="1.0"
# IOS_LATEST_APP_BUILD="27"

# ── Optional (Build / CI) ────────────────────────────────

# Sentry source map uploads (set in Vercel environment)
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Bundle analyzer (set to "true" to generate report)
# ANALYZE=""

# ── Optional (Customization) ─────────────────────────────

# Timezone for date calculations (default: America/Chicago)
# APP_TIMEZONE="America/Chicago"

# ── Scripts Only ──────────────────────────────────────────

# Initial admin account password for prisma/seed.mjs and the /api/seed endpoint.
# REQUIRED in production when the seed endpoint runs — it refuses to fall back to
# a default password there. Development uses a known default if this is unset.
# SEED_ADMIN_PASSWORD="ChangeMeNow123!"

# App Review demo seeding is intentionally fail-closed. Set both values only in
# the isolated review deployment or a local shell targeting that deployment's
# database. APP_REVIEW_DEMO_EXPECTED_HOST must exactly match DATABASE_URL's host.
# APP_REVIEW_DEMO_PASSWORD=""
# APP_REVIEW_DEMO_EXPECTED_HOST="ep-example-pooler.region.aws.neon.tech"
