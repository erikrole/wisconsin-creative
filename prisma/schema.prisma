}

// ── Signature Capture ──────────────────────────────────

model SignatureCollection {
  id                String                    @id @default(cuid())
  sportCode         String                    @map("sport_code")
  season            String
  status            SignatureCollectionStatus @default(OPEN)
  collectionVersion Int                       @default(1) @map("collection_version")
  penSettings       Json                      @map("pen_settings")
  settingsVersion   Int                       @default(1) @map("settings_version")
  firstCaptureAt    DateTime?                 @map("first_capture_at")
  archivedAt        DateTime?                 @map("archived_at")
  archivedById      String?                   @map("archived_by_id")
  createdById       String                    @map("created_by_id")
  updatedById       String                    @map("updated_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  createdBy         User                      @relation("SignatureCollectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                      @relation("SignatureCollectionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy        User?                     @relation("SignatureCollectionArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  snapshots         SignatureRosterSnapshot[]
  members           SignatureMember[]
  captures          SignatureCapture[]
  saveOperations    SignatureSaveOperation[]

  @@unique([sportCode, season])
  @@index([status, updatedAt])
  @@index([sportCode, season])
  @@map("signature_collections")
}

model SignatureRosterSnapshot {
  id             String                  @id @default(cuid())
  collectionId   String                  @map("collection_id")
  status         SignatureSnapshotStatus @default(PREVIEW)
  sourceKey      String                  @map("source_key")
  sourceUrl      String                  @map("source_url")
  sourceHash     String                  @map("source_hash")
  parserVersion  String                  @map("parser_version")
  fetchedAt      DateTime                @map("fetched_at")
  candidateCount Int                     @map("candidate_count")
  entries        Json
  appliedAt      DateTime?               @map("applied_at")
  appliedById    String?                 @map("applied_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  collection     SignatureCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  appliedBy      User?                   @relation("SignatureSnapshotApplier", fields: [appliedById], references: [id], onDelete: SetNull)
  members        SignatureMember[]

  @@unique([collectionId, sourceHash])
  @@index([collectionId, createdAt])
  @@index([collectionId, status])
  @@map("signature_roster_snapshots")
}

model SignatureMember {
  id               String                   @id @default(cuid())
  collectionId     String                   @map("collection_id")
  sourceSnapshotId String?                  @map("source_snapshot_id")
  sourceExternalId String                   @map("source_external_id")
  sourceProfileUrl String?                  @map("source_profile_url")
  name             String
  normalizedName   String                   @map("normalized_name")
  jerseyNumber     Int?                     @map("jersey_number")
  roleGroup        SignatureMemberGroup     @map("role_group")
  title            String?
  active           Boolean                  @default(true)
  required         Boolean                  @default(false)
  linkedUserId     String?                  @map("linked_user_id")
  birthday         DateTime?                @db.Date
  hometown         String?
  instagramHandle  String?                  @map("instagram_handle")
  tiktokHandle     String?                  @map("tiktok_handle")
  xHandle          String?                  @map("x_handle")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  collection       SignatureCollection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceSnapshot   SignatureRosterSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  linkedUser       User?                    @relation("SignatureMemberUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  capture          SignatureCapture?
  saveOperations   SignatureSaveOperation[]

  @@unique([collectionId, sourceExternalId])
  @@index([collectionId, active, required])
  @@index([collectionId, roleGroup, active])
  @@index([linkedUserId])
  @@map("signature_members")
}

model SignatureCapture {
  id                String                      @id @default(cuid())
  collectionId      String                      @map("collection_id")
  memberId          String                      @unique @map("member_id")
  captureVersion    Int                         @default(0) @map("capture_version")
  settingsVersion   Int                         @default(1) @map("settings_version")
  currentRevisionId String?                     @unique @map("current_revision_id")
  capturedAt        DateTime?                   @map("captured_at")
  capturedById      String?                     @map("captured_by_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  collection        SignatureCollection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  member            SignatureMember             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentRevision   SignatureArtifactRevision?  @relation("SignatureCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  capturedBy        User?                       @relation("SignatureCaptureActor", fields: [capturedById], references: [id], onDelete: SetNull)
  revisions         SignatureArtifactRevision[]
  saveOperations    SignatureSaveOperation[]

  @@index([collectionId, updatedAt])
  @@index([collectionId, captureVersion])
  @@map("signature_captures")
}

model SignatureArtifactRevision {
  id                String                   @id @default(cuid())
  captureId         String                   @map("capture_id")
  revision          Int
  state             SignatureArtifactState   @default(PENDING_DELETE)
  pngPath           String                   @map("png_path")
  svgPath           String                   @map("svg_path")
  pngHash           String                   @map("png_hash")
  svgHash           String                   @map("svg_hash")
  width             Int
  height            Int
  cropBounds        Json                     @map("crop_bounds")
  createdAt         DateTime                 @default(now()) @map("created_at")
  committedAt       DateTime?                @map("committed_at")
  replacedAt        DateTime?                @map("replaced_at")
  deletedAt         DateTime?                @map("deleted_at")
  errorMessage      String?                  @map("error_message")
  capture           SignatureCapture         @relation(fields: [captureId], references: [id], onDelete: Cascade)
  currentForCapture SignatureCapture?        @relation("SignatureCurrentRevision")
  saveOperations    SignatureSaveOperation[]

  @@unique([captureId, revision])
  @@index([state, createdAt])
  @@index([captureId, state])
  @@map("signature_artifact_revisions")
}

model SignatureSaveOperation {
  id                     String                     @id @default(cuid())
  requestId              String                     @unique @map("request_id")
  collectionId           String                     @map("collection_id")
  memberId               String                     @map("member_id")
  captureId              String                     @map("capture_id")
  expectedCaptureVersion Int                        @map("expected_capture_version")
  settingsVersion        Int                        @map("settings_version")
  status                 SignatureSaveStatus        @default(UPLOADING)
  revisionId             String?                    @map("revision_id")
  actorUserId            String                     @map("actor_user_id")
  errorMessage           String?                    @map("error_message")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  committedAt            DateTime?                  @map("committed_at")
  collection             SignatureCollection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  member                 SignatureMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  capture                SignatureCapture           @relation(fields: [captureId], references: [id], onDelete: Cascade)
  revision               SignatureArtifactRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  actor                  User                       @relation("SignatureSaveActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([collectionId, memberId, createdAt])
  @@index([status, updatedAt])
  @@index([revisionId])
  @@map("signature_save_operations")
}

// ── Kit / Case grouping ──────────────────────────────────

model Kit {
