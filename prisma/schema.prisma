// ── ICS Calendar Sync ────────────────────────────────────

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum CalendarEventResult {
  WIN
  LOSS
  TIE
}

/// Where a game was played. Distinct from `isHome`, which cannot separate a
/// neutral site from an unknown one — both read as null there.
enum CalendarEventSite {
  HOME
  AWAY
  NEUTRAL
}

model CalendarSource {
  id             String          @id @default(cuid())
  name           String
  url            String
  enabled        Boolean         @default(true)
  lastFetchedAt  DateTime?       @map("last_fetched_at")
  lastError      String?         @map("last_error")
  syncLeaseUntil DateTime?       @map("sync_lease_until")
  syncLeaseOwner String?         @map("sync_lease_owner")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  events         CalendarEvent[]

  @@index([syncLeaseUntil])
  @@map("calendar_sources")
}

model CalendarEvent {
  id              String                @id @default(cuid())
  sourceId        String?               @map("source_id")
  externalId      String                @map("external_id")
  summary         String
  description     String?
  rawSummary      String?               @map("raw_summary")
  rawLocationText String?               @map("raw_location_text")
  rawDescription  String?               @map("raw_description")
  startsAt        DateTime              @map("starts_at")
  endsAt          DateTime              @map("ends_at")
  allDay          Boolean               @default(false) @map("all_day")
  status          CalendarEventStatus   @default(CONFIRMED)
  result          CalendarEventResult?
  site            CalendarEventSite?
  locationId      String?               @map("location_id")
  sportCode       String?               @map("sport_code")
  isHome          Boolean?              @map("is_home")
  isHidden        Boolean               @default(false) @map("is_hidden")
  summaryLocked   Boolean               @default(false) @map("summary_locked")
  isHomeLocked    Boolean               @default(false) @map("is_home_locked")
  locationLocked  Boolean               @default(false) @map("location_locked")
  archivedAt      DateTime?             @map("archived_at")
  subtitle        String?
  opponent        String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  source          CalendarSource?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  location        Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  bookingLinks    BookingEvent[]
  shiftGroup      ShiftGroup?
  travelMembers   EventTravelMember[]
  follows         ScheduleEventFollow[]
  blasts          Blast[]
  workers         EventWorker[]

  @@unique([sourceId, externalId])
  @@index([startsAt, endsAt])
  @@index([locationId])
  @@index([sportCode])
  @@index([archivedAt])
  @@map("calendar_events")
}

enum ScheduleFollowSource {
  MANUAL
  BOOKING
}

/**
 * A person who worked an event, recorded outside the schedule. An admin adds
 * them to an event -- past or future -- without creating a shift, an
 * assignment, or a notification. Scoreboard, profile records, worked-event
 * counts, and shift badges treat an added worker exactly like an active
 * assignment; Schedule, published crews, My Shifts, trades, and ICS never read
 * this table.
 */
model EventWorker {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  userId    String        @map("user_id")
  note      String?
  addedById String?       @map("added_by_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation("EventWorkerUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User?         @relation("EventWorkerAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@map("event_workers")
}

model ScheduleEventFollow {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  eventId   String               @map("event_id")
  source    ScheduleFollowSource @default(MANUAL)
  mutedAt   DateTime?            @map("muted_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CalendarEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, mutedAt])
  @@map("schedule_event_follows")
}

model BookingEvent {
  id        String        @id @default(cuid())
  bookingId String        @map("booking_id")
  eventId   String        @map("event_id")
  ordinal   Int
  createdAt DateTime      @default(now()) @map("created_at")
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([bookingId, eventId])
  @@index([eventId])
  @@index([bookingId, ordinal])
  @@map("booking_events")
}

model LocationMapping {
  id         String   @id @default(cuid())
  pattern    String
  locationId String   @map("location_id")
  priority   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("location_mappings")
}

// ── Notifications ────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum DevicePlatform {
  IOS
  ANDROID

  @@map("device_platform")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  token      String         @unique
  platform   DevicePlatform @default(IOS)
  appVersion String?        @map("app_version")
