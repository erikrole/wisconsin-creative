/// How far auto assignment may go for a sport. Sports are run differently:
/// some are crewed entirely by auto assignment, some staff the full-time
/// positions and deliberately leave student slots open for students to request,
/// and some are held back from automation altogether.
enum SportAutoAssignPolicy {
  /// Fill every open slot, staff and student alike.
  FULL_CREW
  /// Fill staff slots only; student slots stay open for students to request.
  STAFF_ONLY
  /// Propose nothing for this sport.
  HOLD
}

