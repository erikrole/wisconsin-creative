  scans               ScanEvent[]
  products            BulkSkuProduct[]
  units               BulkSkuUnit[]
  kitBulkMembers      KitBulkMembership[]
  favoritedBy         FavoriteItemFamily[]

  @@unique([locationId, binQrCodeValue])
