{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisconsincreative.com/board-sizes/boards.schema.json",
  "title": "Wisconsin board sizes manifest (wisconsin-board-sizes/1)",
  "description": "boards.json: the single hand-edited source for every Wisconsin Athletics venue board. scripts/build-board-sizes.mjs adds the checks JSON Schema can't express (unique ids, canvases matching their boards, zones inside displays).",
  "type": "object",
  "required": ["schema", "version", "updated", "changes", "sources", "canvases", "content", "venues"],
  "properties": {
    "$comment": { "type": "array", "items": { "type": "string" } },
    "schema": { "const": "wisconsin-board-sizes/1" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$", "description": "YYYY-MM-DD.N; bump on every change." },
    "updated": { "type": "string", "format": "date" },
    "changes": {
      "type": "array", "minItems": 1, "description": "Newest first; the first entry is for `version`.",
      "items": {
        "type": "object", "required": ["version", "date", "summary"], "additionalProperties": false,
        "properties": { "version": { "type": "string" }, "date": { "type": "string", "format": "date" }, "summary": { "type": "string" } }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["label", "detail"],
        "properties": { "label": { "type": "string" }, "detail": { "type": "string" } }
      }
    },
    "links": { "type": "object", "properties": { "aeTemplate": { "type": ["string", "null"], "format": "uri" } } },
    "canvases": { "type": "array", "items": { "$ref": "#/$defs/canvas" } },
    "content": {
      "type": "object", "required": ["broad", "gameDay"],
      "properties": {
        "broad": { "type": "array", "items": { "$ref": "#/$defs/contentItem" } },
        "gameDay": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "items"],
            "properties": { "name": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/$defs/contentItem" } } }
          }
        },
        "gameDaySource": { "type": "string" }
      }
    },
    "venues": { "type": "array", "items": { "$ref": "#/$defs/venue" } }
  },
  "$defs": {
    "px": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)+$", "description": "venue/display or venue/display/zone. Stable: never rename." },
    "point": {
      "type": "object", "required": ["x", "y"], "additionalProperties": false,
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } },
      "description": "Pixels from the display's top-left."
    },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Plain information." },
    "issues": {
      "type": "array", "minItems": 1, "description": "Open questions. Surface them; never resolve one silently.",
      "items": {
        "type": "object", "required": ["kind", "text"], "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["conflict", "tbd", "unconfirmed", "naming"] },
          "field": { "type": "string", "description": "The value in question, e.g. fps or h." },
          "text": { "type": "string" }
        }
      }
    },
    "venue": {
      "type": "object", "required": ["id", "name", "code", "displays"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "notes": { "$ref": "#/$defs/notes" },
        "displays": { "type": "array", "items": { "$ref": "#/$defs/display" } }
      }
    },
    "display": {
      "type": "object", "required": ["id", "name", "w", "h", "sources", "zones"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "processor": { "type": "string", "description": "Display Studio processor, e.g. CR-MAIN-P." },
        "name": { "type": "string" },
        "sheetName": { "type": "string" },
        "group": { "type": "string" },
        "w": { "$ref": "#/$defs/px" },
        "h": { "$ref": "#/$defs/px" },
        "sources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" }, "description": "Source key → where that source lists this display." },
        "delivery": {
          "type": "object",
          "properties": {
            "fps": { "type": "string" }, "video": { "type": "string" }, "still": { "type": "string" },
            "audio": { "type": "string" }, "duration": { "type": "string" }
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object", "required": ["kind", "label"],
            "properties": {
              "kind": { "enum": ["crop", "scrim", "seam", "break"] },
              "x": { "type": "integer" }, "y": { "type": "integer" }, "w": { "$ref": "#/$defs/px" }, "h": { "$ref": "#/$defs/px" },
              "label": { "type": "string" }
            }
          }
        },
        "placedNote": { "type": "string" },
        "link": { "type": "object", "required": ["href", "label"], "properties": { "href": { "type": "string", "format": "uri" }, "label": { "type": "string" } } },
        "notes": { "$ref": "#/$defs/notes" },
        "issues": { "$ref": "#/$defs/issues" },
        "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
        "layouts": {
          "type": "array",
          "description": "Named sets of zones used together that fill the board without overlapping. Zones are listed by id; a FG id stands for its BG layer too.",
          "items": {
            "type": "object", "required": ["id", "name", "zones"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "name": { "type": "string" },
              "zones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
              "draft": { "type": "boolean", "description": "Inferred from zone geometry; not yet confirmed against production." }
            }
          }
        }
      }
    },
    "zone": {
      "type": "object", "required": ["id", "n", "name", "w", "h"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "n": { "type": "integer", "minimum": 1, "description": "Order in the source sheet." },
        "name": { "type": "string", "description": "Verbatim from the source, typos included. FG/BG suffixes are processor layers." },
        "w": { "$ref": "#/$defs/px" },
        "h": { "$ref": "#/$defs/px" },
        "at": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "atFrom": { "enum": ["sheet", "guide", "builder", "derived"] },
        "page": { "type": "integer", "description": "2024 content guide page." },
        "pad": { "$ref": "#/$defs/px", "description": "Keep content this many px inside every edge." },
        "duration": { "type": "string" },
        "stillOnly": { "const": true },
        "notes": { "$ref": "#/$defs/notes" },
        "issues": { "$ref": "#/$defs/issues" }
      }
    },
    "canvas": {
      "type": "object", "required": ["key", "venue", "display", "w", "h", "source"],
      "description": "A stable production key. Never rename or resize one without updating the After Effects Board Builder.",
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "venue": { "$ref": "#/$defs/slug" },
        "display": { "type": "string" },
        "zone": { "type": "string" },
        "within": { "const": true },
        "w": { "$ref": "#/$defs/px" },
        "h": { "$ref": "#/$defs/px" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "stillOnly": { "const": true },
        "safeInset": { "$ref": "#/$defs/px" },
        "source": { "type": "string" }
      }
    },
    "contentItem": {
      "type": "object", "required": ["id", "name", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string" },
        "draft": { "type": "boolean" },
        "about": { "type": "string" },
        "duration": { "type": "number" },
        "targets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["venue", "display", "zones"],
            "properties": {
              "venue": { "$ref": "#/$defs/slug" },
              "display": { "type": "string" },
              "zones": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Zone names without FG/BG; null = the whole display." }
            }
          }
        }
      }
    }
  }
}
